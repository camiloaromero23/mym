{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  // src/routeTree.gen.ts is auto-generated by `tsr generate` and must stay
  // tracked in git, but excluded from every tool (oxfmt, oxlint, fallow).
  "ignorePatterns": ["**/routeTree.gen.ts"],
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "ignoreDependencies": [
    "@tanstack/solid-devtools",
    // Reserved for future queryClient wiring (SSR query); intentionally unused for now.
    "@tanstack/solid-router-ssr-query",
    // Production runtime dep: after excluding generated routeTree.gen.ts from
    // analysis, only vite.config.ts imports it, so fallow misclassifies it as
    // test-only. It is the TanStack Start runtime and must stay in dependencies.
    "@tanstack/solid-start",
  ],
  "duplicates": {
    "minOccurrences": 3,
    "mode": "semantic",
  },
  "health": {
    "maxUnitSize": 120,
  },
  "rules": {},
}
