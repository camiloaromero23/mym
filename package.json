{
  "name": "mym",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun vite build",
    "deadcode": "knip",
    "dev": "portless run bun --bun vite dev",
    "format": "oxfmt --ignore-path .oxfmtignore --check .",
    "format:fix": "oxfmt --ignore-path .oxfmtignore .",
    "generate-routes": "bun --bun tsr generate",
    "lint": "oxlint .",
    "nano-staged": "nano-staged",
    "postinstall": "husky",
    "preview": "bun --bun vite preview",
    "start": "bun --bun node .output/server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@corvu/drawer": "0.2.4",
    "@fontsource/inter": "5.3.0",
    "@tanstack/router-plugin": "1.168.36",
    "@tanstack/solid-router": "1.170.31",
    "@tanstack/solid-router-devtools": "1.167.1",
    "@tanstack/solid-router-ssr-query": "1.167.2",
    "@tanstack/solid-start": "1.168.48",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "solid-js": "1.9.15",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.34",
    "@tanstack/solid-devtools": "0.8.12",
    "fallow": "3.22.0",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "nano-staged": "1.0.2",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.15.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  },
  "nano-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.json": [
      "oxfmt --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
