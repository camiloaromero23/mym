{
  "name": "mym",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun vite build",
    "deadcode": "knip",
    "dev": "bun --bun vite dev --port 3000",
    "format": "oxfmt --ignore-path .oxfmtignore --check .",
    "format:fix": "oxfmt --ignore-path .oxfmtignore .",
    "generate-routes": "bun --bun tsr generate",
    "lint": "oxlint .",
    "nano-staged": "nano-staged",
    "postinstall": "husky",
    "preview": "bun --bun vite preview",
    "start": "bun --bun node .output/server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@corvu/drawer": "^0.2.4",
    "@fontsource/inter": "5.2.8",
    "@msviderok/base-ui-solid": "1.0.0-beta.12",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "^1.168.22",
    "@tanstack/solid-router": "1.170.18",
    "@tanstack/solid-router-devtools": "1.167.0",
    "@tanstack/solid-router-ssr-query": "1.167.1",
    "@tanstack/solid-start": "^1.168.30",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.0.8",
    "nitro": "npm:nitro-nightly@latest",
    "solid-js": "1.9.14",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/solid-devtools": "0.8.8",
    "husky": "9.1.7",
    "knip": "6.26.0",
    "nano-staged": "1.0.2",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-solid": "2.11.12"
  },
  "nano-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.json": [
      "oxfmt --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
